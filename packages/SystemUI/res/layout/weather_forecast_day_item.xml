<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Day abbreviation: Sat, Sun, Mon … -->
    <TextView
        android:id="@+id/forecast_day_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp" />

    <!-- Condition icon -->
    <ImageView
        android:id="@+id/forecast_day_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/weather_forecast_condition_desc" />

    <!-- High temp -->
    <TextView
        android:id="@+id/forecast_day_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Low temp -->
    <TextView
        android:id="@+id/forecast_day_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
