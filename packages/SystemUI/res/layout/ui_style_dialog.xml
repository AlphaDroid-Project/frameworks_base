<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ui_style_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:background="@drawable/qs_dialog_bg">

    <!-- Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/ui_style_dialog_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@*android:string/ui_style_dialog_description"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Scrollable List of Styles -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/style_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 0: System Default -->
            <RadioButton
                android:id="@+id/style_radio_system_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@*android:string/ui_style_system_default"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="16sp" />

            <!-- 1: Outline -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_outline" />

            <!-- 2: Neon -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_neon" />

            <!-- 3: Bevel -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_bevel" />

            <!-- 4: Gradient -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_gradient" />

            <!-- 5: Reflective -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_reflective" />

            <!-- 6: Slash -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_slash" />

            <!-- 7: Aerogel -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_aerogel" />

            <!-- 8: Metallic -->
            <include layout="@layout/ui_style_item_row"
                android:id="@+id/row_metallic" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Left: Reset All -->
        <Button
            android:id="@+id/reset_all_button"
            style="@style/Widget.Dialog.Button.BorderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_styles_reset_all_label"
            android:textColor="?android:attr/textColorSecondary"
            android:minWidth="88dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Right: Done -->
        <Button
            android:id="@+id/done_button"
            style="@style/Widget.Dialog.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@*android:string/done_label"
            android:minWidth="88dp" />
    </LinearLayout>

</LinearLayout>
